# SecuraIQ — nginx reverse proxy with TLS termination.
# Get a cert first (e.g. certbot: `certbot certonly --nginx -d securaiq.yourdomain.com`),
# then point the ssl_certificate paths below at it. DNS + certificate issuance
# for your real domain is an operator step — not something the app can do for you.

server {
    listen 80;
    server_name securaiq.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name securaiq.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/securaiq.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/securaiq.yourdomain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    client_max_body_size 20m;  # matches UPLOAD_MAX_MB default headroom

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SSE endpoints — disable proxy buffering so chat streams token-by-token.
    location ~ ^/api/(chat|realtime|tools/run/stream) {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }
}
